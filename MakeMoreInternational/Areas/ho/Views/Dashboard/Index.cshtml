
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/ho/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0">

	<h1 class="h3 mb-3 fw-bold">Dashboard</h1>

	<div class="row row-gap-2">

		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col mt-0">
							<h5 class="card-title">Total Categories</h5>
						</div>

						<div class="col-auto">
							<div class="stat text-primary">
								<i class="align-middle" data-feather="list"></i>
							</div>
						</div>
					</div>
					<h1 class="mt-1 mb-3">@ViewBag.categoryCount</h1>
					<div class="mb-0">
						<a href="/ho/category" class="text-primary"> <i class="mdi mdi-arrow-bottom-right"></i> View more <i class="align-middle" data-feather="arrow-right"></i> </a>						
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col mt-0">
							<h5 class="card-title">Total Products</h5>
						</div>

						<div class="col-auto">
							<div class="stat text-primary">
								<i class="align-middle" data-feather="truck"></i>
							</div>
						</div>
					</div>
					<h1 class="mt-1 mb-3">@ViewBag.productCount</h1>
					<div class="mb-0">
						<a href="/ho/product" class="text-primary"> <i class="mdi mdi-arrow-bottom-right"></i> View more <i class="align-middle" data-feather="arrow-right"></i> </a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col mt-0">
							<h5 class="card-title">Harvest Chart Category</h5>
						</div>

						<div class="col-auto">
							<div class="stat text-primary">
								<i class="align-middle" data-feather="truck"></i>
							</div>
						</div>
					</div>
					<h1 class="mt-1 mb-3">@ViewBag.hcatCount</h1>
					<div class="mb-0">
						<a href="/ho/harvest-category" class="text-primary"> <i class="mdi mdi-arrow-bottom-right"></i> View more <i class="align-middle" data-feather="arrow-right"></i> </a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col mt-0">
							<h5 class="card-title">Harvest Chart Products</h5>
						</div>

						<div class="col-auto">
							<div class="stat text-primary">
								<i class="align-middle" data-feather="list"></i>
							</div>
						</div>
					</div>
					<h1 class="mt-1 mb-3">@ViewBag.hprdCount</h1>
					<div class="mb-0">
						<a href="/ho/harvest-product" class="text-primary"> <i class="mdi mdi-arrow-bottom-right"></i> View more <i class="align-middle" data-feather="arrow-right"></i> </a>
					</div>
				</div>
			</div>
		</div>

		<div class="col-md-4">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col mt-0">
							<h5 class="card-title">Harvest Chart Season</h5>
						</div>

						<div class="col-auto">
							<div class="stat text-primary">
								<i class="align-middle" data-feather="list"></i>
							</div>
						</div>
					</div>
					<h1 class="mt-1 mb-3">@ViewBag.seasonCount</h1>
					<div class="mb-0">
						<a href="/ho/harvest-season" class="text-primary"> <i class="mdi mdi-arrow-bottom-right"></i> View more <i class="align-middle" data-feather="arrow-right"></i> </a>
					</div>
				</div>
			</div>
		</div>

		
	</div>

	
</div>

