@model Infra
@{
    ViewData["Title"] = "Infrastructure";
    Layout = "~/Areas/ho/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid p-0">
    <h1 class="h3 mb-3 fw-bold">@ViewData["Title"]</h1>

    <form asp-action="SaveInfra"
          asp-area="ho" asp-controller="WebPage" enctype="multipart/form-data" method="post" class="form-box">
        @Html.AntiForgeryToken()


        <input type="hidden" name="page" value="infrastructure" />
        <div class="mb-3">
            <label class="form-label">Title</label>
            <input type="text" name="infraTitle" class="form-control" value="@Model?.infraTitle" id="infraTitle" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="infraDesc" id="infraDesc" class="form-control" required>@Model?.infraDesc</textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Images</label>
            <input type="file" name="infImages" multiple class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Old Images</label>
            @if (Model != null)
            {
                <table class="table">
                @foreach (var img in Model.infraImages)
                {
                    <tr>
                        <td>
                            <img src="~/images/infrastructure/@img" width="100" />
                        </td>
                        <td>
                                <a class="btn btn-sm btn-danger" href="delete-infra-image/@img">Delete</a>
                        </td>
                    </tr>
                }
                </table>
            }
        </div>


        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
}

